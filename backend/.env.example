# Export these in your shell before starting the app; this file is not auto-loaded.
# Optional local model connection. Leave unset to use source lookup without AI.
# Set to the exact name of a model already installed in your local model server.
# OLLAMA_MODEL=your-installed-model-name
# OLLAMA_URL=http://127.0.0.1:11434
# WORKBENCH_DB=/absolute/path/to/workbench.sqlite3
# Optional outbound email adapter; never used automatically by the browser.
# SMTP_ENABLED=false
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_FROM=
# SMTP_USERNAME=
# SMTP_PASSWORD=
